+    if outIds.len >= index.candidateRuleCount - minRuleIndex:
+      scratch.candidateValid = true
+      return
+  
+    let n = text.len
+    if n == 0:
+      scratch.candidateValid = true
+      return
+  
+    var i = 0
+    var prev = text[0]
+    while true:
