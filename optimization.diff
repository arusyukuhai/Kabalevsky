+    for byte in countup(0, EMBEDDING_ENTRY_COUNT - 1, 8):
+      if a[0].embedding[byte] != b[0].embedding[byte]: inc mapDiff
+    d += 0.50 * float(mapDiff) / 32.0
+  d
